# Copy this file to .env (same folder) for local previews with real data.
# .env is gitignored and never committed.

# Read-only login (the same value as DATABASE_URL in Netlify)
DATABASE_URL=postgresql://site_reader:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Only needed for `npm run fetch-photos`: a login that can write ref_species_photos
# (the photo_loader role from sql/species_photos.sql, or the database owner)
# PHOTOS_DATABASE_URL=postgresql://photo_loader:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
