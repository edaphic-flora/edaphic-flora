---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page isn't here." noindex>
  <div class="narrow nf">
    <span class="eyebrow">404</span>
    <h1 class="h1">Nothing growing here.</h1>
    <p class="lede">That page doesn't exist, or the species may have moved. Try searching for it.</p>
    <form action="/species/" method="get" class="search" role="search">
      <label for="q404" class="sr-only">Search for a plant</label>
      <input id="q404" name="q" class="input" placeholder="Search a plant" />
      <button class="btn btn-gold" type="submit">Search</button>
    </form>
  </div>
</Base>

<style>
  .nf { padding-top: clamp(64px, 9vw, 120px); padding-bottom: 40px; }
  .nf .h1 { margin-top: 14px; }
  .nf .lede { margin-top: 16px; }
  .search { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; max-width: 520px; }
  .search .input { flex: 1; min-width: 220px; }
</style>
