---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SoilArt from '../components/SoilArt.astro';
import SpeciesCard from '../components/SpeciesCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { featured, totals, thresholds } from '../lib/data.js';
import { SITE_URL, SITE_NAME } from '../config.js';
import { sitePhotos } from '../lib/sitePhotos.js';

// Feature card photos (credited in the title attribute, like species cards)
const cardPhoto = (sp) => sp && { src: sp.photo.src, alt: `${sp.displayName} (${sp.scientific_name})`, title: sp.photoCredit.text };
const nativePhoto = cardPhoto(sitePhotos.native);
const wildlifePhoto = cardPhoto(sitePhotos.wildlife);
const picks = featured(4);
const t = thresholds;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE_URL}/species/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];
---
<Base
  description="A soil and plant database: real pH, organic matter, and texture from community soil tests, plus native status by state and wildlife value for the plants you grow."
  active="home"
  jsonLd={jsonLd}
>
  <Hero />

  <section class="wrap section">
    <div class="why">
      <p class="lede">
        Edaphic Flora is built from real measurements at real sites, aggregated, sourced, and shown with the sample
        counts behind them.
      </p>
    </div>
    <div class="pillars">
      <div class="card pad">
        <SoilArt />
        <h3 class="h3">Soil, sourced</h3>
        <p>pH, organic matter, texture, and nutrients, shown as ranges with the number of samples behind them.</p>
      </div>
      <div class="card pad">
        {nativePhoto && <div class="p-photo"><img {...nativePhoto} loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>}
        <h3 class="h3">Native, by state</h3>
        <p>Native, introduced, and invasive status for all 50 states and DC, from BONAP and state invasive lists.</p>
      </div>
      <div class="card pad">
        {wildlifePhoto && <div class="p-photo"><img {...wildlifePhoto} loading="lazy" decoding="async" referrerpolicy="no-referrer" /></div>}
        <h3 class="h3">Wildlife value</h3>
        <p>How many moths, butterflies, and specialist bees a plant supports, and what it offers birds.</p>
      </div>
    </div>
  </section>

  {picks.length > 0 && (
    <section class="wrap section">
      <div class="row-head">
        <div>
          <span class="eyebrow">Start exploring</span>
          <h2 class="h2" style="font-size:clamp(26px,3.4vw,38px);margin-top:6px">Featured species</h2>
        </div>
        <a href="/species/" class="link">Browse all {totals.species.toLocaleString()} →</a>
      </div>
      <div class="grid-cards" style="margin-top:28px">
        {picks.map((sp) => <SpeciesCard sp={sp} />)}
      </div>
    </section>
  )}

  <section class="wrap section">
    <div class="honest">
      <div class="h-copy">
        <h2 class="h2" style="font-size:clamp(24px,3vw,34px)">How to read the soil numbers</h2>
        <p class="lede" style="margin-top:16px">
          Community soil data is still growing. Every soil number shows how many samples back it, even when that's
          one. A measurement gets a range once it has {t.min_range_samples} or more samples; before that you see the
          readings themselves, and species with none yet show USDA reference data.
        </p>
      </div>
      <div class="h-states">
        <div class="state ok">
          <div class="st-hd"><span class="dot" style="background:var(--sage)"></span><strong>Range</strong><span class="mono">{t.min_range_samples}+ samples</span></div>
          <p>Middle 80% of samples, plus the median.</p>
        </div>
        <div class="state not">
          <div class="st-hd"><span class="dot" style="background:var(--gold)"></span><strong>Early readings</strong><span class="mono">1 or 2 samples</span></div>
          <p>The actual values, each with its count.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .why { max-width: 760px; }
  .pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 18px; margin-top: 44px; }
  .pillars .card { padding: 0 0 24px; overflow: hidden; border: none; border-radius: 18px; box-shadow: 0 10px 26px rgba(55, 61, 60, 0.07); }
  .pillars :global(.p-photo) { height: 180px; overflow: hidden; background: var(--tile-empty); }
  .pillars .p-photo img { width: 100%; height: 100%; object-fit: cover; }
  .pillars h3 { margin: 18px 24px 0; }
  .pillars p { font-weight: 300; font-size: 17px; line-height: 1.55; color: var(--ink-soft); margin: 8px 24px 0; }
  .row-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .honest { background: var(--sand); border-radius: 24px; padding: clamp(28px, 4vw, 48px); display: flex; gap: clamp(28px, 4vw, 56px); flex-wrap: wrap; align-items: center; }
  .h-copy { flex: 1; min-width: min(280px, 100%); }
  .h-states { flex: 0.8; min-width: min(260px, 100%); display: flex; flex-direction: column; gap: 12px; }
  .state { background: var(--paper); border-radius: 12px; padding: 16px 18px; }
  .state.ok { border: 1px solid rgba(122, 154, 134, 0.4); }
  .state.not { border: 1px dashed rgba(211, 155, 53, 0.6); }
  .st-hd { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .st-hd strong { font-family: var(--f-head); font-weight: 600; font-size: 13px; }
  .st-hd .mono { margin-left: auto; font-size: 12px; color: var(--ink-muted); }
  .state.not .st-hd .mono { color: var(--gold-ink); }
  .state p { font-size: 16px; color: var(--ink-soft); margin-top: 8px; }
</style>
