---
// Renders the repo's TERMS.md, so the terms have one source.
import Base from '../layouts/Base.astro';
import { Content } from '../../../TERMS.md';
---
<Base title="Terms of service" description="The terms for using Edaphic Flora and contributing soil data.">
  <article class="narrow legal">
    <Content />
  </article>
</Base>

<style>
  .legal { padding-top: clamp(40px, 6vw, 72px); padding-bottom: 24px; }
  .legal :global(h1) { font-weight: 700; font-size: clamp(30px, 4vw, 42px); letter-spacing: -0.5px; }
  .legal :global(h2) { font-weight: 700; font-size: 24px; margin-top: 36px; }
  .legal :global(h3) { font-weight: 600; font-size: 18px; margin-top: 22px; }
  .legal :global(p), .legal :global(li) { font-size: 18px; line-height: 1.6; color: var(--ink-soft); }
  .legal :global(p) { margin-top: 12px; }
  .legal :global(ul) { margin-top: 10px; padding-left: 22px; }
  .legal :global(li) { margin-top: 6px; }
  .legal :global(a) { color: var(--sage-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
