---
import { CONTRIBUTE_URL, PH_SCALE } from '../config.js';
import { thresholds } from '../lib/data.js';
import { plural } from '../lib/names.js';
const { sp } = Astro.props;
const s = sp.soil;
const u = sp.usda;
const ready = sp.soilReady;
const minRange = thresholds.min_range_samples;
// One or two readings: show them as they are. "6.4 and 7.1", or "6.8".
const readings = (m, unit = '') =>
  m.lo == null || m.lo === m.hi ? `${(m.lo ?? m.p50).toFixed(1)}${unit}` : `${m.lo.toFixed(1)} and ${m.hi.toFixed(1)}${unit}`;
const phMarks = s?.ph && s.ph.p10 == null ? [...new Set([s.ph.lo ?? s.ph.p50, s.ph.hi ?? s.ph.p50])] : [];
const early = ready && [s.ph, s.organic_matter].some((m) => m && m.p10 == null);
const pos = (v) => Math.max(0, Math.min(100, ((v - PH_SCALE.min) / (PH_SCALE.max - PH_SCALE.min)) * 100));
const pct = (v) => `${pos(v).toFixed(1)}%`;
const usdaPh = u?.ph_min != null && u?.ph_max != null ? { min: u.ph_min, max: u.ph_max } : null;
const ticks = [4.0, 5.5, 7.0, 8.5].map((v) => ({ v, at: pct(v), num: v.toFixed(1), word: v === 4 ? 'acidic' : v === 7 ? 'neutral' : v === 8.5 ? 'alkaline' : '' }));
const nutrients = ready
  ? [
      ['Phosphorus (P)', s.nutrients?.phosphorus],
      ['Potassium (K)', s.nutrients?.potassium],
      ['Calcium (Ca)', s.nutrients?.calcium],
      ['Magnesium (Mg)', s.nutrients?.magnesium],
    ].filter(([, v]) => v)
  : [];
const n = s?.sample_count || 0;
const c = s?.contributor_count || 0;
const refBits = [
  usdaPh && `pH ${usdaPh.min.toFixed(1)} to ${usdaPh.max.toFixed(1)}`,
  u?.moisture_use && `moisture use ${u.moisture_use.toLowerCase()}`,
  u?.drought_tolerance && `drought tolerance ${u.drought_tolerance.toLowerCase()}`,
  u?.salinity_tolerance && `salinity tolerance ${u.salinity_tolerance.toLowerCase()}`,
].filter(Boolean);
---
<section aria-labelledby="soil-h">
  <h2 id="soil-h" class="sec-h">Soil snapshot</h2>

  {ready ? (
    <div class="ready">
      <div class="based"><span class="dot" style="background:var(--sage)"></span>based on {plural(n, 'sample')} from {plural(c, 'contributor')}</div>
      {early && (
        <p class="early">Early data: each measurement shows its readings until it has {minRange} or more samples, then a range.</p>
      )}

      {s.ph && (
        <div class="card pad block">
          <div class="b-hd">
            <span class="b-t">Soil pH</span>
            {s.ph.p10 != null ? (
              <span class="mono b-v">{s.ph.p10.toFixed(1)} to {s.ph.p90.toFixed(1)} · median <span class="gold">{s.ph.p50.toFixed(1)}</span></span>
            ) : (
              <span class="mono b-v"><span class="gold">{readings(s.ph)}</span> · {plural(s.ph.n, 'sample')}</span>
            )}
          </div>
          <div class="ph">
            <div class="ph-grad"></div>
            {s.ph.p10 != null && <div class="ph-range" style={`left:${pct(s.ph.p10)};width:${(pos(s.ph.p90) - pos(s.ph.p10)).toFixed(1)}%`}></div>}
            {s.ph.p10 != null ? (
              <div class="ph-mark" style={`left:${pct(s.ph.p50)}`}></div>
            ) : (
              phMarks.map((v) => <div class="ph-mark" style={`left:${pct(v)}`}></div>)
            )}
            {usdaPh && <div class="ph-usda" style={`left:${pct(usdaPh.min)};width:${(pos(usdaPh.max) - pos(usdaPh.min)).toFixed(1)}%`}></div>}
          </div>
          <div class="ticks">{ticks.map((t) => <span style={`left:${t.at}`}>{t.num}{t.word && <i> {t.word}</i>}</span>)}</div>
          <p class="key">
            {s.ph.p10 != null ? (
              <><span class="sw sw-range"></span> middle 80% of samples <span class="sw sw-mark"></span> median</>
            ) : (
              <><span class="sw sw-mark"></span> {s.ph.n === 1 ? 'the one reading so far' : 'each reading'}</>
            )}
            {usdaPh && (<><span class="sw sw-usda"></span> USDA PLANTS range</>)}
          </p>
        </div>
      )}

      <div class="two">
        {s.organic_matter && (
          <div class="card pad">
            <div class="b-t">Organic matter</div>
            {s.organic_matter.p10 != null ? (
              <>
                <div class="mono big">{s.organic_matter.p50.toFixed(1)}%</div>
                <div class="mono sub">middle 80%: {s.organic_matter.p10.toFixed(1)} to {s.organic_matter.p90.toFixed(1)}% · {plural(s.organic_matter.n, 'sample')}</div>
              </>
            ) : (
              <>
                <div class="mono big">{readings(s.organic_matter, '%')}</div>
                <div class="mono sub">{plural(s.organic_matter.n, 'sample')}</div>
              </>
            )}
          </div>
        )}
        {s.texture && (
          <div class="card pad">
            <div class="b-hd"><span class="b-t">Texture</span><span class="mono b-v">{s.texture.class}</span></div>
            <div class="tex"><div style={`width:${s.texture.sand}%;background:#C9A86A`}></div><div style={`width:${s.texture.silt}%;background:#8A9A86`}></div><div style={`width:${s.texture.clay}%;background:#6B5D49`}></div></div>
            <div class="tex-lbl mono"><span>{s.texture.sand}% sand</span><span>{s.texture.silt}% silt</span><span>{s.texture.clay}% clay</span></div>
            <div class="mono sub">{s.texture.n === 1 ? 'from 1 sample' : `median of ${plural(s.texture.n, 'sample')}`}</div>
          </div>
        )}
      </div>

      {nutrients.length > 0 && (
        <div class="card nut">
          <div class="b-t nut-hd">Key nutrients <span class="mono sub">median, ppm</span></div>
          <div class="nut-grid">
            {nutrients.map(([name, v]) => (
              <div class="nut-row"><span>{name}</span><span class="mono">{v.p50.toLocaleString()} ppm <span class="n">· {plural(v.n, 'sample')}</span></span></div>
            ))}
          </div>
          <p class="caveat">Labs use different extraction methods (for example Mehlich-3 and Modified Morgan), so treat nutrient values as rough guides.</p>
        </div>
      )}
    </div>
  ) : (
    <div class="empty">
      <div class="q mono">?</div>
      <h3>No community soil data yet</h3>
      <p>Nobody has added a soil test for this species yet. The first one shows up here, with its sample count.</p>
      <a href={`${CONTRIBUTE_URL}?species=${encodeURIComponent(sp.scientific_name)}`} class="btn btn-gold">Add a soil test for this plant →</a>
      {refBits.length > 0 && (
        <div class="ref">
          <div class="ref-hd">USDA PLANTS reference</div>
          <div class="mono ref-v">{refBits.join(' · ')}</div>
          {usdaPh && (
            <div class="ph slim">
              <div class="ph-grad"></div>
              <div class="ph-usda solid" style={`left:${pct(usdaPh.min)};width:${(pos(usdaPh.max) - pos(usdaPh.min)).toFixed(1)}%`}></div>
            </div>
          )}
          {usdaPh && <div class="ticks">{ticks.map((t) => <span style={`left:${t.at}`}>{t.num}{t.word && <i> {t.word}</i>}</span>)}</div>}
        </div>
      )}
    </div>
  )}
</section>

<style>
  .sec-h { font-weight: 700; font-size: clamp(22px, 3vw, 30px); letter-spacing: -0.3px; }
  .based { display: inline-flex; align-items: center; gap: 8px; font-family: var(--f-data); font-size: 12px; color: var(--sage-ink); background: rgba(122, 154, 134, 0.16); padding: 7px 13px; border-radius: 20px; margin-top: 18px; }
  .block { margin-top: 16px; }
  .b-hd { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; }
  .b-t { font-family: var(--f-head); font-weight: 600; font-size: 16px; }
  .b-v { font-size: 14px; color: var(--ink-soft); }
  .gold { color: var(--gold-ink); }
  .ph { position: relative; height: 14px; margin-top: 18px; }
  .ph.slim { height: 10px; margin-top: 12px; }
  .ph-grad { position: absolute; inset: 0; border-radius: 7px; background: linear-gradient(90deg, #c97b5a, #d3b05a, #7a9a86, #5e7468); opacity: 0.35; }
  .ph-range { position: absolute; top: 0; bottom: 0; border-radius: 7px; border: 2px solid var(--sage-ink); background: rgba(122, 154, 134, 0.35); }
  .ph-mark { position: absolute; top: -4px; width: 3px; height: 22px; border-radius: 2px; background: var(--gold); transform: translateX(-1px); }
  .ph-usda { position: absolute; bottom: -9px; height: 4px; border-radius: 2px; background: repeating-linear-gradient(90deg, var(--brown) 0 6px, transparent 6px 10px); }
  .ph-usda.solid { top: 0; bottom: 0; height: auto; border-radius: 6px; background: rgba(107, 93, 73, 0.45); border: 2px solid var(--brown); }
  .ticks { position: relative; height: 16px; margin-top: 18px; font-family: var(--f-data); font-size: 10.5px; color: var(--bark); }
  .ticks span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
  .ticks span:first-child { transform: none; }
  .ticks span:last-child { transform: translateX(-100%); }
  .ticks i { font-style: normal; }
  @media (max-width: 480px) { .ticks i { display: none; } }
  .key { margin-top: 14px; font-family: var(--f-data); font-size: 11px; color: var(--ink-muted); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .sw { display: inline-block; width: 16px; height: 8px; border-radius: 3px; margin-left: 8px; }
  .sw:first-child { margin-left: 0; }
  .sw-range { background: rgba(122, 154, 134, 0.35); border: 2px solid var(--sage-ink); }
  .sw-mark { width: 3px; height: 12px; background: var(--gold); }
  .sw-usda { height: 4px; background: repeating-linear-gradient(90deg, var(--brown) 0 6px, transparent 6px 10px); }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 14px; }
  .big { font-size: 26px; margin-top: 8px; }
  .sub { font-size: 12px; color: var(--ink-muted); margin-top: 4px; font-weight: 400; }
  .tex { display: flex; height: 12px; border-radius: 6px; overflow: hidden; margin-top: 14px; }
  .tex-lbl { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--bark); margin-top: 8px; }
  .nut { margin-top: 14px; padding: 8px; }
  .nut-hd { padding: 12px 14px 6px; font-size: 15px; }
  .nut-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .nut-row { padding: 12px 14px; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 16px; color: var(--ink-soft); }
  .nut-row .mono { color: var(--charcoal); white-space: nowrap; }
  .nut-row .n { color: var(--ink-muted); font-size: 12px; }
  .early { margin-top: 10px; font-size: 15px; color: var(--bark); line-height: 1.45; }
  .caveat { font-size: 14.5px; color: var(--bark); padding: 4px 14px 12px; line-height: 1.45; }
  .empty { margin-top: 18px; background: var(--paper); border: 1px dashed rgba(211, 155, 53, 0.65); border-radius: 16px; padding: clamp(26px, 4vw, 40px); text-align: center; }
  .q { width: 52px; height: 52px; margin: 0 auto; border-radius: 50%; background: rgba(211, 155, 53, 0.16); display: flex; align-items: center; justify-content: center; font-size: 22px; color: var(--gold-ink); }
  .empty h3 { font-weight: 600; font-size: 21px; margin-top: 16px; }
  .empty > p { font-weight: 300; font-size: 18px; line-height: 1.55; color: var(--ink-soft); margin: 10px auto 22px; max-width: 50ch; }
  .ref { text-align: left; margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--line); }
  .ref-hd { font-family: var(--f-head); font-weight: 600; font-size: 13px; letter-spacing: 0.3px; }
  .ref-v { font-size: 13px; color: var(--ink-soft); margin-top: 6px; line-height: 1.6; }
</style>
