---
// Hero 1a: editorial, atmospheric (dark)
import { totals } from '../lib/data.js';
const { hidden = false } = Astro.props;
---
<section id="hero-a" class="hero dark" hidden={hidden}>
  <div class="bg1"></div>
  <div class="bg2"></div>
  <div class="wrap inner">
    <span class="kicker"><span class="dot" style="background:var(--gold)"></span>Open soil + plant database · no login</span>
    <h1>what's really going on down there?</h1>
    <p class="lead">
      Edaphic Flora pairs lab soil tests with the real sites where plants grow, so you can see the pH, organic matter,
      and texture a species <em>actually</em> thrives in. Peer-reviewed data meets running barefoot through the tall grass.
    </p>
    <form action="/species/" method="get" class="search" role="search">
      <label for="q-a" class="sr-only">Search for a plant</label>
      <input id="q-a" name="q" class="input" placeholder="Search a plant, e.g. little bluestem" autocomplete="off" />
      <button type="submit" class="btn btn-gold">Search</button>
    </form>
    <dl class="stats">
      <div><dt>Species tracked</dt><dd>{totals.species.toLocaleString()}</dd></div>
      <div><dt>Soil samples</dt><dd>{totals.samples.toLocaleString()}</dd></div>
      <div><dt>US states mapped</dt><dd>50<span>+DC</span></dd></div>
    </dl>
  </div>
</section>

<style>
  .hero { background: var(--charcoal-deep); }
  .bg1 { position: absolute; inset: 0; background: repeating-linear-gradient(122deg, #2e3433 0 26px, #333a38 26px 52px); opacity: 0.9; }
  .bg2 {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 78% 18%, rgba(122, 154, 134, 0.22) 0%, rgba(46, 52, 51, 0) 55%),
      radial-gradient(90% 70% at 10% 95%, rgba(107, 93, 73, 0.35) 0%, rgba(46, 52, 51, 0) 60%);
  }
  .inner { position: relative; padding-top: clamp(64px, 9vw, 120px); padding-bottom: clamp(56px, 7vw, 96px); }
  .kicker { display: inline-flex; align-items: center; gap: 9px; font-family: var(--f-data); font-size: 12px; letter-spacing: 1px; color: var(--sage-pale); text-transform: uppercase; }
  h1 { font-family: var(--f-brand); font-weight: 400; color: var(--limestone); font-size: clamp(44px, 8vw, 92px); line-height: 1.02; margin-top: 22px; max-width: 16ch; }
  .lead { font-weight: 300; color: rgba(247, 244, 232, 0.82); font-size: clamp(18px, 2.2vw, 23px); line-height: 1.55; margin-top: 26px; max-width: 56ch; }
  .search { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; max-width: 600px; }
  .search .input { flex: 1; min-width: 240px; background: rgba(247, 244, 232, 0.06); border-color: rgba(247, 244, 232, 0.22); color: var(--limestone); }
  .search .input::placeholder { color: rgba(247, 244, 232, 0.5); }
  .stats { display: flex; gap: clamp(28px, 5vw, 56px); margin: 44px 0 0; flex-wrap: wrap; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-family: var(--f-data); font-size: clamp(28px, 4vw, 38px); color: var(--limestone); font-weight: 500; }
  .stats dd span { font-size: 0.6em; color: var(--sage-muted); }
  .stats dt { font-family: var(--f-head); font-size: 11px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--sage-muted); margin-top: 4px; }
</style>
