---
// Hero 1b: data-forward, search-first (light) with a live soil snapshot card
import { browseOrder, featured } from '../lib/data.js';
import { PH_SCALE } from '../config.js';
const { hidden = false } = Astro.props;

// Prefer a species with a real community snapshot; otherwise fall back to a
// featured species and show its USDA reference range, clearly labeled.
const ready = browseOrder.find((s) => s.soilReady && s.soil.ph);
const fb = featured(4).find((s) => s.usda?.ph_min != null);
const sp = ready || fb;
const community = !!ready;
const pos = (v) => `${Math.max(0, Math.min(100, ((v - PH_SCALE.min) / (PH_SCALE.max - PH_SCALE.min)) * 100))}%`;
const ph = sp && (community ? sp.soil.ph : { p10: sp.usda.ph_min, p90: sp.usda.ph_max, p50: null });
const om = community ? sp.soil.organic_matter : null;
const tx = community ? sp.soil.texture : null;
const examples = featured(2);
---
<section id="hero-b" class="hero" hidden={hidden}>
  <div class="wrap inner">
    <div class="copy">
      <span class="kicker"><span class="dot" style="background:var(--sage)"></span>The soil database for what you grow</span>
      <h1>Know the soil a plant actually grows in.</h1>
      <p class="lead">
        Free, instant, no account. Look up a species and see its native range plus the real pH, organic matter, and
        texture from soil tests that gardeners and researchers contributed.
      </p>
      <form action="/species/" method="get" class="search" role="search">
        <label for="q-b" class="sr-only">Search for a plant</label>
        <input id="q-b" name="q" class="input" placeholder="Search a plant, e.g. butterfly weed" autocomplete="off" />
        <button type="submit" class="btn btn-gold">Search</button>
      </form>
      {examples.length > 0 && (
        <div class="try">
          Try {examples.map((e, i) => (<>{i > 0 && ' · '}<a href={e.url}>{e.common_name || e.displayName}</a></>))}
        </div>
      )}
    </div>

    {sp && ph && (
      <div class="snap">
        <div class="snap-top">
          <div class="mono name">{sp.scientific_name}</div>
          <div class="mono count">{community ? `${sp.soil.sample_count} samples` : 'USDA reference'}</div>
        </div>
        <div class="sub">{sp.displayName} · {community ? 'soil snapshot' : 'reference range'}</div>
        <div class="rows">
          <div>
            <div class="row-hd"><span>pH</span><span class="v">{ph.p10.toFixed(1)} to {ph.p90.toFixed(1)}{ph.p50 != null && ` · median ${ph.p50.toFixed(1)}`}</span></div>
            <div class="track">
              <div class="range" style={`left:${pos(ph.p10)};width:calc(${pos(ph.p90)} - ${pos(ph.p10)})`}></div>
              {ph.p50 != null && <div class="mark" style={`left:${pos(ph.p50)}`}></div>}
            </div>
          </div>
          {om && (
            <div>
              <div class="row-hd"><span>Organic matter</span><span class="v">median {om.p50.toFixed(1)}%</span></div>
              <div class="track"><div class="range" style={`left:${Math.min(om.p10 * 8, 90)}%;width:${Math.max(4, Math.min((om.p90 - om.p10) * 8, 100))}%`}></div></div>
            </div>
          )}
          {tx && (
            <div>
              <div class="row-hd"><span>Texture</span><span class="v">{tx.class}</span></div>
              <div class="tex"><div style={`width:${tx.sand}%;background:#C9A86A`}></div><div style={`width:${tx.silt}%;background:#8A9A86`}></div><div style={`width:${tx.clay}%;background:#6B5D49`}></div></div>
              <div class="tex-lbl"><span>{tx.sand}% sand</span><span>{tx.silt}% silt</span><span>{tx.clay}% clay</span></div>
            </div>
          )}
          {!community && <p class="note">Community soil data for this species is still coming in. This is the USDA PLANTS pH range.</p>}
        </div>
        <a href={sp.url} class="btn btn-sage full">See the full species page →</a>
      </div>
    )}
  </div>
</section>

<style>
  .hero { background: var(--limestone); border-bottom: 1px solid var(--line); }
  .inner { padding-top: clamp(56px, 7vw, 92px); padding-bottom: clamp(56px, 7vw, 92px); display: flex; gap: clamp(32px, 5vw, 72px); flex-wrap: wrap; align-items: center; }
  .copy { flex: 1.1; min-width: min(320px, 100%); }
  .kicker { display: inline-flex; align-items: center; gap: 9px; font-family: var(--f-data); font-size: 12px; letter-spacing: 1px; color: var(--ink-muted); text-transform: uppercase; }
  h1 { font-weight: 700; font-size: clamp(38px, 5.4vw, 64px); line-height: 1.05; margin-top: 18px; letter-spacing: -0.5px; }
  .lead { font-weight: 300; color: var(--ink-soft); font-size: clamp(18px, 2.1vw, 22px); line-height: 1.55; margin-top: 22px; max-width: 50ch; }
  .search { margin-top: 30px; display: flex; gap: 12px; flex-wrap: wrap; max-width: 560px; }
  .search .input { flex: 1; min-width: 220px; }
  .try { font-size: 16px; color: var(--ink-muted); margin-top: 14px; }
  .try a { color: var(--sage-ink); text-underline-offset: 3px; font-family: var(--f-data); font-size: 14px; }
  .snap { flex: 0.9; min-width: min(300px, 100%); background: var(--charcoal-deep); border-radius: 16px; padding: 26px 28px; box-shadow: 0 18px 44px rgba(55, 61, 60, 0.18); color: var(--limestone); }
  .snap-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .name { font-size: 17px; font-weight: 500; }
  .count { font-size: 11px; color: var(--sage-muted); white-space: nowrap; }
  .sub { font-family: var(--f-head); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: var(--sage-muted); margin-top: 4px; }
  .rows { margin-top: 22px; display: flex; flex-direction: column; gap: 16px; }
  .row-hd { display: flex; justify-content: space-between; gap: 10px; font-family: var(--f-data); font-size: 12px; color: rgba(247, 244, 232, 0.7); margin-bottom: 7px; }
  .row-hd .v { color: var(--limestone); text-align: right; }
  .track { position: relative; height: 8px; border-radius: 5px; background: rgba(247, 244, 232, 0.12); }
  .range { position: absolute; top: 0; bottom: 0; border-radius: 5px; background: var(--sage); }
  .mark { position: absolute; top: -3px; width: 3px; height: 14px; border-radius: 2px; background: var(--gold); transform: translateX(-1px); }
  .tex { display: flex; height: 8px; border-radius: 5px; overflow: hidden; }
  .tex-lbl { display: flex; justify-content: space-between; font-family: var(--f-data); font-size: 10px; color: var(--sage-muted); margin-top: 6px; }
  .note { font-size: 15px; color: rgba(247, 244, 232, 0.7); line-height: 1.45; }
  .full { display: flex; width: 100%; margin-top: 22px; font-size: 13px; padding: 11px; border-radius: 8px; }
</style>
