---
const { sp } = Astro.props;
const u = sp.usda || {};
const rows = [
  ['Family', sp.family],
  ['Growth habit', u.growth_habit],
  ['Duration', u.duration],
  ['North America status', u.native_status_na],
  ['Shade tolerance', u.shade_tolerance],
  ['Drought tolerance', u.drought_tolerance],
  ['Moisture use', u.moisture_use],
  ['Salinity tolerance', u.salinity_tolerance],
  ['Soil pH range', u.ph_min != null && u.ph_max != null ? `${u.ph_min.toFixed(1)} to ${u.ph_max.toFixed(1)}` : null],
  ['Bloom period', u.bloom_period],
  ['USDA symbol', sp.usda_symbol],
].filter(([, v]) => v);
---
<div class="card pad">
  <div class="hd"><h3 class="t">USDA traits</h3><span class="tag">reference</span></div>
  {rows.length ? (
    <dl>
      {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  ) : (
    <p class="none">No USDA PLANTS record matched this name.</p>
  )}
  {sp.usda_symbol && (
    <p class="src"><a href={`https://plants.usda.gov/plant-profile/${sp.usda_symbol}`} rel="noopener">USDA PLANTS profile →</a></p>
  )}
</div>

<style>
  .hd { display: flex; align-items: center; gap: 8px; }
  .t { font-weight: 600; font-size: 18px; }
  .tag { font-size: 15px; font-style: italic; color: var(--ink-muted); }
  dl { margin: 12px 0 0; }
  dl div { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(55, 61, 60, 0.08); }
  dt { font-size: 16px; color: var(--ink-soft); }
  dd { margin: 0; font-size: 17px; color: var(--charcoal); text-align: right; }
  .none { font-size: 16px; color: var(--ink-soft); margin-top: 12px; }
  .src { margin-top: 14px; font-family: var(--f-head); font-weight: 600; font-size: 13px; }
  .src a { color: var(--sage-ink); }
</style>
