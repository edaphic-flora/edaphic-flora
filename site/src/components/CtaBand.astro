---
import { CONTRIBUTE_URL } from '../config.js';
import { sitePhotos } from '../lib/sitePhotos.js';
const {
  heading = 'better data from the ground up.',
  body = 'Enter your lab results and the plants growing in that soil.',
} = Astro.props;
const bg = sitePhotos.band;
---
<section class="wrap section">
  <div class="band">
    {bg && <img class="band-photo" src={bg.photo.large} alt="" title={bg.photoCredit.text} loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
    <div class="scrim"></div>
    <div class="inner">
      <h2>{heading}</h2>
      <p>{body}</p>
      <a href={CONTRIBUTE_URL} class="btn btn-gold big">Add a soil test →</a>
    </div>
    {bg && <p class="band-credit">{bg.photoCredit.text}</p>}
  </div>
</section>

<style>
  /* Limestone text sits on a charcoal scrim over the photo (white text only on charcoal) */
  .band {
    position: relative; overflow: hidden; border-radius: 24px; padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px);
    text-align: center; background: var(--charcoal-deep); color: var(--limestone);
  }
  .band-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(38, 43, 42, 0.62), rgba(38, 43, 42, 0.8)); }
  .inner { position: relative; }
  h2 { font-family: var(--f-brand); font-weight: 400; color: var(--limestone); font-size: clamp(28px, 4vw, 46px); line-height: 1.1; }
  p { font-weight: 300; font-size: clamp(17px, 2vw, 21px); color: rgba(247, 244, 232, 0.85); margin: 18px auto 0; max-width: 56ch; line-height: 1.55; }
  .big { margin-top: 28px; font-size: 16px; padding: 16px 32px; border-radius: 10px; }
  .band-credit { position: absolute; right: 18px; bottom: 12px; margin: 0; font-size: 12.5px; color: rgba(247, 244, 232, 0.72); max-width: calc(100% - 36px); }
  @media (max-width: 560px) { .band-credit { position: relative; right: auto; bottom: auto; margin-top: 22px; } }
</style>
