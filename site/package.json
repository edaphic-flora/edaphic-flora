{
  "name": "edaphic-flora-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Public static site for Edaphic Flora (edaphicflora.org)",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/export-data.mjs && astro dev",
    "export-data": "node --env-file-if-exists=.env scripts/export-data.mjs",
    "fetch-photos": "node --env-file-if-exists=.env scripts/fetch-photos.mjs",
    "build": "node --env-file-if-exists=.env scripts/export-data.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/baumans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/rokkitt": "^5.3.0",
    "astro": "^7.4.11",
    "firebase": "^12.19.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  }
}
